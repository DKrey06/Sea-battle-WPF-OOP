<Window x:Class="Sea_battle_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sea_battle_WPF" xmlns:viewmodels="clr-namespace:Sea_battle_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Sea battle" 
        Height="700" 
        Width="1100" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary Source="Resources.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панелька с лого и подключением -->
        <DockPanel Grid.Row="0" 
                   Background="{StaticResource SecondaryBrush}"
                   Height="60"
                   LastChildFill="False">

            <!-- Лого и текст -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                <Image Source="/Images/FunCat4.png" 
                       Width="50" 
                       Height="50" 
                       Margin="10,0,5,0"/>
                <TextBlock Foreground="{StaticResource TextBrush}"
                           FontFamily="Comic Sans MS"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="250"
                           TextAlignment="Center" 
                           Width="223">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" 
                                          Color="{StaticResource AccentPurple}" 
                                          BlurRadius="2" 
                                          Opacity="0.6"/>
                    </TextBlock.Effect><Run Text="Да победит "/><Run Language="ru-ru" Text=" "/><Run Text="же сильнейший                             в Мяурском сражении!"/></TextBlock>
            </StackPanel>

            <!-- Кнопка настроек и кнопка Назад -->
            <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">

                <!-- Кнопка Назад (как в HotSeat) -->
                <Button Content="← Назад"
                        Style="{StaticResource ModernButton}"
                        Width="80"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="BackButton_Click"/>

                <!-- Кнопка настроек -->
                <Button Content="⚙" 
                        FontSize="16"
                        Width="40" 
                        Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </DockPanel>

        <!-- Остальной код остается без изменений -->
        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Добавляем новую колонку для панели кораблей -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <!-- Колонка для панели кораблей -->
                <ColumnDefinition Width="20"/>
                <!-- Отступ -->
                <ColumnDefinition Width="*"/>
                <!-- Левое поле -->
                <ColumnDefinition Width="20"/>
                <!-- Разделитель -->
                <ColumnDefinition Width="*"/>
                <!-- Правое поле -->
            </Grid.ColumnDefinitions>

            <!-- ПАНЕЛЬ РУЧНОЙ РАССТАНОВКИ КОРАБЛЕЙ -->
            <Border Grid.Column="0"
                    Background="{StaticResource SecondaryBrush}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="2"
                    Padding="10"
                    Margin="0,0,10,0">

                <!-- Управление видимостью через триггер -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- Скрываем, если НЕ режим ручной расстановки -->
                            <DataTrigger Binding="{Binding IsManualPlacementMode}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Скрываем, если игра началась -->
                            <DataTrigger Binding="{Binding IsGameStarted}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="Ручная расстановка" 
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Доступные корабли:" 
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <!-- Контейнер для кораблей с прокруткой -->
                    <Border BorderBrush="{StaticResource DarkBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Height="180"
                            Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableShips}"
                                          Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" 
                                                Padding="8,5" 
                                                CornerRadius="5"
                                                Cursor="Hand">
                                            <!-- Подсветка выбранного корабля -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource DarkBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource WaterBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Размер корабля -->
                                                <TextBlock Text="{Binding Size}" 
                                                           Grid.Column="0"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Width="25"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Визуализация корабля -->
                                                <Border Grid.Column="1" 
                                                        Height="24" 
                                                        Margin="10,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                    <!-- Фиксированная ширина в зависимости от размера -->
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Width" Value="30"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Size}" Value="2">
                                                                    <Setter Property="Width" Value="55"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Size}" Value="3">
                                                                    <Setter Property="Width" Value="80"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Size}" Value="4">
                                                                    <Setter Property="Width" Value="105"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Rectangle Fill="{StaticResource ShipBrush}"
                                                               RadiusX="3" 
                                                               RadiusY="3"
                                                               Stroke="Black"
                                                               StrokeThickness="1">
                                                        <!-- Поворот для вертикальных кораблей -->
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="LayoutTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Direction}" Value="Vertical">
                                                                        <Setter Property="LayoutTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Border>

                                                <!-- Кнопки управления -->
                                                <StackPanel Grid.Column="2" 
                                                            Orientation="Horizontal" 
                                                            VerticalAlignment="Center">
                                                    <!-- Кнопка выбора/размещения -->
                                                    <Button Content="✓" 
                                                            Width="28" 
                                                            Height="28"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.SelectShipCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Выбрать корабль"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource ShipBrush}"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Кнопка удаления -->
                                                    <Button Content="×" 
                                                            Width="28" 
                                                            Height="28"
                                                            Command="{Binding DataContext.RemoveShipCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Удалить корабль"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                        <Setter Property="Background" Value="#FF6B6B"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Панель управления -->
                    <StackPanel Margin="0,5,0,0">
                        <Button Content="↻ Повернуть корабль" 
                                Command="{Binding RotateShipCommand}"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,6"
                                Height="32"
                                FontSize="13"
                                ToolTip="Повернуть выбранный корабль (R)"
                                Cursor="Hand"/>

                        <Button Content="⟲ Сбросить все корабли" 
                                Command="{Binding ResetManualPlacementCommand}"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,10"
                                Height="32"
                                FontSize="13"
                                ToolTip="Удалить все корабли и расставить автоматически"
                                Cursor="Hand"/>

                        <!-- Статус расстановки -->
                        <Border CornerRadius="6"
                                Padding="10,8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource DarkBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFE0E0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="True">
                                            <Setter Property="Background" Value="#E8FFE8"/>
                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="False">
                                            <Setter Property="Background" Value="#FFE8E8"/>
                                            <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Иконка статуса -->
                                <TextBlock FontSize="18" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⏳"/>
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="False">
                                                    <Setter Property="Text" Value="✗"/>
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Текст статуса -->
                                <TextBlock Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="160">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Выберите корабль и разместите его на поле"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="True">
                                                    <Setter Property="Text" Value="Все корабли размещены правильно"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="False">
                                                    <Setter Property="Text" Value="Разместите все корабли правильно"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Инструкция -->
                        <TextBlock Text="Инструкция:"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,3"
                                   FontSize="12"/>

                        <StackPanel>
                            <TextBlock Text="1. Выберите корабль из списка"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="2. Наведите на поле для предпросмотра"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="3. Кликните для размещения"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="4. Красная подсветка = нельзя разместить"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Отступ между панелью и полем -->
            <Rectangle Grid.Column="1" 
                       Fill="Transparent"
                       Width="10"/>

            <!-- Левое поле (теперь в колонке 2) -->
            <Border Grid.Column="2" 
                    Background="{StaticResource WaterBrush}"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Аватар и имя игрока -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15">
                        <Image Source="Images/Piratcat1.png" 
                               Width="40" 
                               Height="40"
                               Margin="0,0,10,0"/>
                        <TextBlock Text="Кот" 
                                   Style="{StaticResource HeaderText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Подпись поля -->
                    <TextBlock Grid.Row="1"
                               Text="Мое поле" 
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Viewbox Grid.Row="2"
         Stretch="Uniform" 
         MaxWidth="350" 
         MaxHeight="350" 
         HorizontalAlignment="Center"
         VerticalAlignment="Center">
                        <ItemsControl x:Name="PlayerField" 
              ItemsSource="{Binding PlayerCells}"
              HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="10" Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CellStyle}">
                                        <Border Background="{Binding CellColor}">
                                            <!-- ДОБАВЛЯЕМ ОБРАБОТЧИКИ ДЛЯ ПОЛЯ ИГРОКА -->
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                                    <i:InvokeCommandAction 
                                Command="{Binding DataContext.PlayerCellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding}"/>
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction 
                                Command="{Binding DataContext.PlayerCellMouseEnterCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding}"/>
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeave">
                                                    <i:InvokeCommandAction 
                                Command="{Binding DataContext.PlayerCellMouseLeaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Разделитель между полями (теперь в колонке 3) -->
            <Rectangle Grid.Column="3" 
                       Fill="{StaticResource AccentBrush}"
                       Width="3" 
                       RadiusX="2" 
                       RadiusY="2"
                       VerticalAlignment="Stretch"
                       Margin="0,50"/>

            <!-- Правое поле противника (теперь в колонке 4) -->
            <Border Grid.Column="4" 
                    Background="{StaticResource WaterBrush}"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Аватар и имя противника -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15">
                        <TextBlock Text="Противник" 
                                   Style="{StaticResource HeaderText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Image Source="Images/Piratcat2.png" 
                               Width="40" 
                               Height="40"/>
                    </StackPanel>

                    <!-- Подпись поля -->
                    <TextBlock Grid.Row="1"
                               Text="Поле противника" 
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <!-- Игровое поле противника -->
                    <Viewbox Grid.Row="2"
         Stretch="Uniform" 
         MaxWidth="350" 
         MaxHeight="350" 
         HorizontalAlignment="Center"
         VerticalAlignment="Center">
                        <ItemsControl x:Name="EnemyField" 
                  ItemsSource="{Binding EnemyCells}"
                  HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="10" Columns="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CellStyle}">
                                        <Border Background="{Binding CellColor}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                                    <i:InvokeCommandAction 
                                    Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панелька управления -->
        <Border Grid.Row="2" 
                Background="{StaticResource SecondaryBrush}"
                Height="90"
                CornerRadius="10,10,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Статус игры -->
                <Border Grid.Column="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="1"
                        Padding="15,8"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="GameStatusText" 
                               Text="{Binding GameStatus}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <!-- Кнопки управления -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Button x:Name="StartGameButton" 
                            Content="Начать игру" 
                            Style="{StaticResource ModernButton}"
                            Width="110"
                            Height="38"
                            FontSize="13"
                            Click="StartGame_Click"/>

                    <Button x:Name="AutoArrangeButton" 
                            Content="Расставить автоматически" 
                            Style="{StaticResource ModernButton}"
                            Width="180"
                            Height="38"
                            FontSize="13"
                            Click="AutoArrange_Click"/>

                    <Button x:Name="SurrenderButton" 
                            Content="Сдаться" 
                            Style="{StaticResource ModernButton}"
                            Width="85"
                            Height="38"
                            FontSize="13"
                            Command="{Binding SurrenderCommand}"/>

                </StackPanel>

                <!-- Легенда -->
                <StackPanel Grid.Column="2" 
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="15" Height="15" Background="{StaticResource ShipBrush}" 
                                BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Корабль" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="15" Height="15" Background="{StaticResource HitBrush}" 
                                BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Попадание" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="15" Height="15" Background="#A0D1E8" 
                                BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Промах" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>

        <!-- Окно настроек (скрытое) -->
        <Border x:Name="SettingsPanel"
        Grid.RowSpan="3"
        Background="#CCFFFFFF"
        Visibility="Collapsed"
        Panel.ZIndex="1000">
            <Border Background="{StaticResource PrimaryBrush}"
            BorderBrush="{StaticResource DarkBrush}"
            BorderThickness="2"
            CornerRadius="15"
            Width="320"
            Height="260"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
                <StackPanel Margin="20">
                    <TextBlock Text="Настройки игры" 
                       Style="{StaticResource HeaderText}"
                       Margin="0,0,0,15"/>

                    <TextBlock Text="Уровень сложности ИИ:" 
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="Bold"
                       Margin="0,5"/>

                    <StackPanel Margin="0,10">
                        <RadioButton Content="🧠 Умный ИИ (добивает корабли)" 
             IsChecked="{Binding IsSmartAI, Mode=OneWay}"
             Command="{Binding SetSmartAICommand}"
             GroupName="AILevel"
             Margin="0,5">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                    <Setter Property="IsEnabled" Value="{Binding CanChangeAILevel}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton Content="🤖 Простой ИИ (случайные ходы)" 
             IsChecked="{Binding IsEasyAI, Mode=OneWay}"
             Command="{Binding SetEasyAICommand}"
             GroupName="AILevel"
             Margin="0,5">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                    <Setter Property="IsEnabled" Value="{Binding CanChangeAILevel}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedAILevelDisplay, StringFormat='Текущий уровень: {0}'}" 
                       Foreground="#9C27B0"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5"/>

                    <Button Content="Закрыть" 
                    Style="{StaticResource ModernButton}"
                    Margin="0,15,0,0"
                    Click="CloseSettings_Click"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>