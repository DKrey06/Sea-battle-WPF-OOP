<Window x:Class="Sea_battle_WPF.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sea_battle_WPF"
        xmlns:viewmodels="clr-namespace:Sea_battle_WPF.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Морской бой - Сеть" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToReadyConverter x:Key="BoolToReadyConverter"/>
            <local:ReadyColorConverter x:Key="ReadyColorConverter"/>
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панелька с лого и названием -->
        <DockPanel Grid.Row="0" 
                   Background="{StaticResource SecondaryBrush}"
                   Height="60"
                   LastChildFill="False">

            <!-- Лого и текст -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                <Image Source="/Images/FunCat4.png" 
                       Width="50" 
                       Height="50" 
                       Margin="10,0,5,0"/>
                <TextBlock Foreground="{StaticResource TextBrush}"
                           FontFamily="Comic Sans MS"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="250"
                           TextAlignment="Center" 
                           Width="223">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" 
                                          Color="{StaticResource AccentPurple}" 
                                          BlurRadius="2" 
                                          Opacity="0.6"/>
                    </TextBlock.Effect>
                    <Run Text="Сетевой морской бой - "/>
                    <Run Text="Сражение через интернет!"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - управление подключением -->
            <Border Grid.Column="0"
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Margin="10">

                <StackPanel Margin="15">
                    <TextBlock Text="Сетевая игра"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Статус -->
                    <Border CornerRadius="8"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource DarkBrush}"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Статус:"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GameStatus}"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Управление подключением -->
                    <Button Content="Подключиться"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,0,0,10"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>

                    <!-- КНОПКА СОЗДАНИЯ КОМНАТЫ -->
                    <Button Content="Создать комнату"
                            Command="{Binding CreateRoomCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,0,0,10"
                            IsEnabled="{Binding CanCreateRoom}"/>

                    <!-- Ввод ID комнаты -->
                    <TextBlock Text="ID комнаты для присоединения:"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,10,0,5"/>

                    <TextBox x:Name="RoomIdInput"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,5"
                     IsEnabled="{Binding CanJoinRoom}"/>

                    <!-- КНОПКА ПРИСОЕДИНЕНИЯ -->
                    <Button Content="Присоединиться"
                            Command="{Binding JoinRoomCommand}"
                            CommandParameter="{Binding Text, ElementName=RoomIdInput}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,5,0,15"
                            IsEnabled="{Binding CanJoinRoom}"/>

                    <!-- Информация о комнате -->
                    <Border CornerRadius="8"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource DarkBrush}"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ID комнаты:"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RoomId}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,5,0,10"/>

                            <TextBlock Text="{Binding OpponentStatus}"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Вы: "
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsReady, Converter={StaticResource BoolToReadyConverter}}"
                                           Foreground="{Binding IsReady, Converter={StaticResource ReadyColorConverter}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Соперник: "
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsOpponentReady, Converter={StaticResource BoolToReadyConverter}}"
                                           Foreground="{Binding IsOpponentReady, Converter={StaticResource ReadyColorConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка готовности -->
                    <Button Content="Готов"
                            Command="{Binding ReadyCommand}"
                            Height="40"
                            Margin="0,0,0,10"
                            IsEnabled="{Binding IsManualPlacementValid}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                        <Setter Property="Background" Value="#45a049"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#cccccc"/>
                                        <Setter Property="Foreground" Value="#666666"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Отключиться -->
                    <Button Content="Отключиться"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Background="#FF6B6B"
                            IsEnabled="{Binding IsConnected}">
                    </Button>
                </StackPanel>
            </Border>

            <!-- Игровые поля -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок статуса -->
                <Border Grid.Row="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="8"
                        Padding="15"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,15">
                    <TextBlock Text="{Binding GameStatus}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Поля -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Мое поле -->
                    <Border Grid.Column="0"
                            Background="{StaticResource WaterBrush}"
                            CornerRadius="10"
                            Padding="15"
                            BorderBrush="{StaticResource DarkBrush}"
                            BorderThickness="2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Аватар и имя игрока -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,15">
                                <Image Source="Images/Piratcat1.png" 
                                       Width="40" 
                                       Height="40"
                                       Margin="0,0,10,0"/>
                                <TextBlock Text="Вы" 
                                           Style="{StaticResource HeaderText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Подпись поля -->
                            <TextBlock Grid.Row="1"
                                       Text="Мое поле" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <!-- Игровое поле -->
                            <Viewbox Grid.Row="2"
                                     Stretch="Uniform" 
                                     MaxWidth="350" 
                                     MaxHeight="350" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding PlayerCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="10" Columns="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CellStyle}">
                                                <Border Background="{Binding CellColor}">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.PlayerCellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="MouseEnter">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.PlayerCellMouseEnterCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="MouseLeave">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.PlayerCellMouseLeaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Разделитель -->
                    <Rectangle Grid.Column="1" 
                               Fill="{StaticResource AccentBrush}"
                               Width="3" 
                               RadiusX="2" 
                               RadiusY="2"
                               VerticalAlignment="Stretch"
                               Margin="0,50"/>

                    <!-- Поле противника -->
                    <Border Grid.Column="2"
                            Background="{StaticResource WaterBrush}"
                            CornerRadius="10"
                            Padding="15"
                            BorderBrush="{StaticResource DarkBrush}"
                            BorderThickness="2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Аватар и имя противника -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,15">
                                <TextBlock Text="Соперник" 
                                           Style="{StaticResource HeaderText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Image Source="Images/Piratcat2.png" 
                                       Width="40" 
                                       Height="40"/>
                            </StackPanel>

                            <!-- Подпись поля -->
                            <TextBlock Grid.Row="1"
                                       Text="Поле противника" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <!-- Игровое поле противника -->
                            <Viewbox Grid.Row="2"
                                     Stretch="Uniform" 
                                     MaxWidth="350" 
                                     MaxHeight="350" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding EnemyCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="10" Columns="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CellStyle}">
                                                <Border Background="{Binding CellColor}"
                                                        Cursor="Hand">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Правая панель ручная расстановка кораблей -->
            <Border Grid.Column="2"
        Background="{StaticResource SecondaryBrush}"
        CornerRadius="10"
        BorderBrush="{StaticResource DarkBrush}"
        BorderThickness="2"
        Padding="10"
        Margin="10,0,0,0">

                <!-- Управление видимостью через триггер -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- Скрываем, если игра началась -->
                            <DataTrigger Binding="{Binding IsGameStarted}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Скрываем, если игрок уже готов -->
                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Скрываем, если нет подключения -->
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="Ручная расстановка" 
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <!-- Переключение режимов -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Ручная"
                                Command="{Binding SwitchToManualModeCommand}"
                                Width="80"
                                Height="30"
                                Margin="0,0,5,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualPlacementMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Авто"
                                Command="{Binding SwitchToAutoModeCommand}"
                                Width="80"
                                Height="30">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualPlacementMode}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Доступные корабли:" 
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"
                               Visibility="{Binding IsManualPlacementMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Контейнер для кораблей с прокруткой -->
                    <Border BorderBrush="{StaticResource DarkBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Height="180"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsManualPlacementMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableShips}"
                                          Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" 
                                                Padding="8,5" 
                                                CornerRadius="5"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource DarkBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource WaterBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Размер корабля -->
                                                <TextBlock Text="{Binding Size}" 
                                                           Grid.Column="0"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Width="25"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Визуализация корабля -->
                                                <Border Grid.Column="1" 
                                                        Height="24" 
                                                        Margin="10,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Width" Value="30"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Size}" Value="2">
                                                                    <Setter Property="Width" Value="55"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Size}" Value="3">
                                                                    <Setter Property="Width" Value="80"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Size}" Value="4">
                                                                    <Setter Property="Width" Value="105"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Rectangle Fill="{StaticResource ShipBrush}"
                                                               RadiusX="3" 
                                                               RadiusY="3"
                                                               Stroke="Black"
                                                               StrokeThickness="1">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="LayoutTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Direction}" Value="Vertical">
                                                                        <Setter Property="LayoutTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Border>

                                                <!-- Кнопки управления -->
                                                <StackPanel Grid.Column="2" 
                                                            Orientation="Horizontal" 
                                                            VerticalAlignment="Center">
                                                    <!-- Кнопка выбора/размещения -->
                                                    <Button Content="✓" 
                                                            Width="28" 
                                                            Height="28"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.SelectShipCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Выбрать корабль"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource ShipBrush}"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Кнопка удаления -->
                                                    <Button Content="×" 
                                                            Width="28" 
                                                            Height="28"
                                                            Command="{Binding DataContext.RemoveShipCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Удалить корабль"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                        <Setter Property="Background" Value="#FF6B6B"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Панель управления для ручного режима -->
                    <StackPanel Margin="0,5,0,0"
                                Visibility="{Binding IsManualPlacementMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="↻ Повернуть корабль" 
                                Command="{Binding RotateShipCommand}"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,6"
                                Height="32"
                                FontSize="13"
                                ToolTip="Повернуть выбранный корабль (R)"
                                Cursor="Hand"/>

                        <Button Content="⟲ Сбросить все корабли" 
                                Command="{Binding ResetManualPlacementCommand}"
                                Style="{StaticResource ModernButton}"
                                Margin="0,0,0,10"
                                Height="32"
                                FontSize="13"
                                ToolTip="Удалить все корабли"
                                Cursor="Hand"/>

                        <!-- Статус расстановки -->
                        <Border CornerRadius="6"
                                Padding="10,8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource DarkBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFE0E0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="True">
                                            <Setter Property="Background" Value="#E8FFE8"/>
                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="False">
                                            <Setter Property="Background" Value="#FFE8E8"/>
                                            <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Иконка статуса -->
                                <TextBlock FontSize="18" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⏳"/>
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="False">
                                                    <Setter Property="Text" Value="✗"/>
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Текст статуса -->
                                <TextBlock Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="160">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Выберите корабль и разместите его на поле"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="True">
                                                    <Setter Property="Text" Value="Все корабли размещены правильно"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsManualPlacementValid}" Value="False">
                                                    <Setter Property="Text" Value="Разместите все корабли правильно"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Инструкция -->
                        <TextBlock Text="Инструкция:"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,3"
                                   FontSize="12"/>

                        <StackPanel>
                            <TextBlock Text="1. Выберите корабль из списка"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="2. Наведите на поле для предпросмотра"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="3. Кликните для размещения"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="4. Красная подсветка = нельзя разместить"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопка авторасстановки (показывается в авторежиме) -->
                    <Button Content="Расставить автоматически"
                            Command="{Binding AutoArrangeCommand}"
                            Height="35"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsManualPlacementMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManualPlacementMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>