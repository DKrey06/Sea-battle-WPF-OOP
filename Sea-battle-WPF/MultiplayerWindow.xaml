<Window x:Class="Sea_battle_WPF.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sea_battle_WPF"
        xmlns:viewmodels="clr-namespace:Sea_battle_WPF.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Морской бой - Сеть" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary Source="Resources.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панелька с лого и названием -->
        <DockPanel Grid.Row="0" 
                   Background="{StaticResource SecondaryBrush}"
                   Height="60"
                   LastChildFill="False">

            <!-- Лого и текст -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                <Image Source="/Images/FunCat4.png" 
                       Width="50" 
                       Height="50" 
                       Margin="10,0,5,0"/>
                <TextBlock Foreground="{StaticResource TextBrush}"
                           FontFamily="Comic Sans MS"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="250"
                           TextAlignment="Center" 
                           Width="223">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" 
                                          Color="{StaticResource AccentPurple}" 
                                          BlurRadius="2" 
                                          Opacity="0.6"/>
                    </TextBlock.Effect>
                    <Run Text="Сетевой морской бой - "/>
                    <Run Text="Сражение через интернет!"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - управление (ОСТАВЛЕНО КАК БЫЛО) -->
            <Border Grid.Column="0"
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Margin="10">

                <StackPanel Margin="15">
                    <TextBlock Text="Сетевая игра"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Статус -->
                    <Border CornerRadius="8"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource DarkBrush}"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Статус:"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GameStatus}"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Управление подключением -->
                    <Button Content="Подключиться"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,0,0,10"/>

                    <Button Content="Создать комнату"
                            Command="{Binding CreateRoomCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,0,0,10"/>

                    <!-- Ввод ID комнаты -->
                    <TextBlock Text="ID комнаты для присоединения:"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,10,0,5"/>

                    <TextBox x:Name="RoomIdInput"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,5"/>

                    <Button Content="Присоединиться"
                            Command="{Binding JoinRoomCommand}"
                            CommandParameter="{Binding Text, ElementName=RoomIdInput}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,5,0,15"/>

                    <!-- Информация о комнате -->
                    <Border CornerRadius="8"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource DarkBrush}"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ID комнаты:"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RoomId}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,5,0,10"/>

                            <TextBlock Text="{Binding OpponentStatus}"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Вы: "
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsReady, Converter={StaticResource BoolToReadyConverter}}"
                                           Foreground="{Binding IsReady, Converter={StaticResource ReadyColorConverter}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Соперник: "
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding IsOpponentReady, Converter={StaticResource BoolToReadyConverter}}"
                                           Foreground="{Binding IsOpponentReady, Converter={StaticResource ReadyColorConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кнопка готовности -->
                    <Button Content="Готов"
                            Command="{Binding ReadyCommand}"
                            Height="40"
                            Margin="0,0,0,10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                        <Setter Property="Background" Value="#4CAF50"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Авторасстановка -->
                    <Button Content="Авторасстановка"
                            Command="{Binding AutoArrangeCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Margin="0,0,0,15"/>

                    <!-- Отключиться -->
                    <Button Content="Отключиться"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="35"
                            Background="#FF6B6B"/>
                </StackPanel>
            </Border>

            <!-- Игровые поля -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок статуса -->
                <Border Grid.Row="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="8"
                        Padding="15"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,15">
                    <TextBlock Text="{Binding GameStatus}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Поля -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Мое поле с обновленным оформлением -->
                    <Border Grid.Column="0"
                            Background="{StaticResource WaterBrush}"
                            CornerRadius="10"
                            Padding="15"
                            BorderBrush="{StaticResource DarkBrush}"
                            BorderThickness="2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Аватар и имя игрока -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,15">
                                <Image Source="Images/Piratcat1.png" 
                                       Width="40" 
                                       Height="40"
                                       Margin="0,0,10,0"/>
                                <TextBlock Text="Вы" 
                                           Style="{StaticResource HeaderText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Подпись поля -->
                            <TextBlock Grid.Row="1"
                                       Text="Мое поле" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <!-- Игровое поле -->
                            <Viewbox Grid.Row="2"
                                     Stretch="Uniform" 
                                     MaxWidth="350" 
                                     MaxHeight="350" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding PlayerCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="10" Columns="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CellStyle}">
                                                <Border Background="{Binding CellColor}">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.PlayerCellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="MouseEnter">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.PlayerCellMouseEnterCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="MouseLeave">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.PlayerCellMouseLeaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Разделитель -->
                    <Rectangle Grid.Column="1" 
                               Fill="{StaticResource AccentBrush}"
                               Width="3" 
                               RadiusX="2" 
                               RadiusY="2"
                               VerticalAlignment="Stretch"
                               Margin="0,50"/>

                    <!-- Поле противника с обновленным оформлением -->
                    <Border Grid.Column="2"
                            Background="{StaticResource WaterBrush}"
                            CornerRadius="10"
                            Padding="15"
                            BorderBrush="{StaticResource DarkBrush}"
                            BorderThickness="2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Аватар и имя противника -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,15">
                                <TextBlock Text="Соперник" 
                                           Style="{StaticResource HeaderText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Image Source="Images/Piratcat2.png" 
                                       Width="40" 
                                       Height="40"/>
                            </StackPanel>

                            <!-- Подпись поля -->
                            <TextBlock Grid.Row="1"
                                       Text="Поле противника" 
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <!-- Игровое поле противника -->
                            <Viewbox Grid.Row="2"
                                     Stretch="Uniform" 
                                     MaxWidth="350" 
                                     MaxHeight="350" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding EnemyCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="10" Columns="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CellStyle}">
                                                <Border Background="{Binding CellColor}"
                                                        Cursor="Hand">
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                                            <i:InvokeCommandAction 
                                                                Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>