<Window x:Class="Sea_battle_WPF.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sea_battle_WPF"
        xmlns:viewmodels="clr-namespace:Sea_battle_WPF.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Морской бой - Сеть" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - управление -->
        <Border Grid.Column="0"
                Background="{StaticResource SecondaryBrush}"
                BorderBrush="{StaticResource DarkBrush}"
                BorderThickness="2"
                CornerRadius="10"
                Margin="10">

            <StackPanel Margin="15">
                <TextBlock Text="Сетевая игра"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Статус -->
                <Border CornerRadius="8"
                        Padding="10"
                        BorderThickness="1"
                        BorderBrush="{StaticResource DarkBrush}"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Статус:"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GameStatus}"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Управление подключением -->
                <Button Content="Подключиться"
                        Command="{Binding ConnectCommand}"
                        Style="{StaticResource ModernButton}"
                        Height="35"
                        Margin="0,0,0,10"/>

                <Button Content="Создать комнату"
                        Command="{Binding CreateRoomCommand}"
                        Style="{StaticResource ModernButton}"
                        Height="35"
                        Margin="0,0,0,10"/>

                <!-- Ввод ID комнаты -->
                <TextBlock Text="ID комнаты для присоединения:"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,10,0,5"/>

                <TextBox x:Name="RoomIdInput"
                 Style="{StaticResource ModernTextBox}"
                 Margin="0,0,0,5"/>

                <Button Content="Присоединиться"
                        Command="{Binding JoinRoomCommand}"
                        CommandParameter="{Binding Text, ElementName=RoomIdInput}"
                        Style="{StaticResource ModernButton}"
                        Height="35"
                        Margin="0,5,0,15"/>

                <!-- Информация о комнате -->
                <Border CornerRadius="8"
                        Padding="10"
                        BorderThickness="1"
                        BorderBrush="{StaticResource DarkBrush}"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="ID комнаты:"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RoomId}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,5,0,10"/>

                        <TextBlock Text="{Binding OpponentStatus}"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Вы: "
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding IsReady, Converter={StaticResource BoolToReadyConverter}}"
                                       Foreground="{Binding IsReady, Converter={StaticResource ReadyColorConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Соперник: "
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding IsOpponentReady, Converter={StaticResource BoolToReadyConverter}}"
                                       Foreground="{Binding IsOpponentReady, Converter={StaticResource ReadyColorConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Кнопка готовности -->
                <Button Content="Готов"
                        Command="{Binding ReadyCommand}"
                        Height="40"
                        Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Авторасстановка -->
                <Button Content="Авторасстановка"
                        Command="{Binding AutoArrangeCommand}"
                        Style="{StaticResource ModernButton}"
                        Height="35"
                        Margin="0,0,0,15"/>

                <!-- Отключиться -->
                <Button Content="Отключиться"
                        Command="{Binding DisconnectCommand}"
                        Style="{StaticResource ModernButton}"
                        Height="35"
                        Background="#FF6B6B"/>
            </StackPanel>
        </Border>

        <!-- Игровые поля -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок статуса -->
            <Border Grid.Row="0"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="8"
                    Padding="15"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,15">
                <TextBlock Text="{Binding GameStatus}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Поля -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Мое поле -->
                <Border Grid.Column="0"
                        Background="{StaticResource WaterBrush}"
                        CornerRadius="10"
                        Padding="15"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Мое поле"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <Viewbox Stretch="Uniform" 
                                 MaxWidth="350" 
                                 MaxHeight="350" 
                                 HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding PlayerCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="10" Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="30" Height="30" 
                                                BorderBrush="Black" 
                                                BorderThickness="1">
                                            <Border.Background>
                                                <Binding Path="CellColor"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Rectangle Grid.Column="1" 
                           Fill="{StaticResource AccentBrush}"
                           Width="3" 
                           RadiusX="2" 
                           RadiusY="2"/>

                <!-- Поле противника -->
                <Border Grid.Column="2"
                        Background="{StaticResource WaterBrush}"
                        CornerRadius="10"
                        Padding="15"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Поле противника"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <Viewbox Stretch="Uniform" 
                                 MaxWidth="350" 
                                 MaxHeight="350" 
                                 HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding EnemyCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="10" Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="30" Height="30" 
                                                BorderBrush="Black" 
                                                BorderThickness="1"
                                                Cursor="Hand">
                                            <Border.Background>
                                                <Binding Path="CellColor"/>
                                            </Border.Background>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                                    <i:InvokeCommandAction 
                                                        Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>