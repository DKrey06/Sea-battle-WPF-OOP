<Window x:Class="Sea_battle_WPF.HotSeatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sea_battle_WPF"
        xmlns:viewmodels="clr-namespace:Sea_battle_WPF.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance Type=viewmodels:HotSeatViewModel}"
        mc:Ignorable="d"
        Title="Sea Battle - Hot Seat"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary Source="Resources.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" 
                   Background="{StaticResource SecondaryBrush}"
                   Height="60"
                   LastChildFill="False">

            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                <Image Source="/Images/FunCat4.png" 
                       Width="50" 
                       Height="50" 
                       Margin="10,0,5,0"/>
                <TextBlock Text="{Binding CurrentPlayerName, StringFormat='👥 Hot Seat: Ходит {0}'}"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="Comic Sans MS"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Content="← Назад"
                    Style="{StaticResource ModernButton}"
                    Width="80"
                    Height="35"
                    Margin="0,0,10,0"
                    DockPanel.Dock="Right"
                    Click="BackButton_Click"/>
        </DockPanel>

        <!-- ОКНО БЛОКИРОВКИ -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="Black"
                Visibility="{Binding DeviceLockVisibility}"
                Panel.ZIndex="1000">
            <Border Background="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource DarkBrush}"
                    BorderThickness="3"
                    CornerRadius="20"
                    Width="400"
                    Height="250"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📱 ПЕРЕДАЙТЕ УСТРОЙСТВО"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding GameStatus}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="350"
                               Margin="0,0,0,30"/>

                    <Button Content="✅ УСТРОЙСТВО ПЕРЕДАНО"
                            Command="{Binding PassDeviceCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="250"
                            Height="50"
                            FontSize="16"
                            FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
        <Grid Grid.Row="1" 
              Margin="20"
              Visibility="{Binding FieldVisibility}">

            <!-- ИГРОВЫЕ ПОЛЯ (показываются всегда, кроме экрана "Оба готовы") -->
            <Grid Visibility="{Binding ShouldShowReadyScreen, Converter={StaticResource InverseBooleanConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левое поле: Мое поле -->
                <Border Grid.Column="0" 
                        Background="{StaticResource WaterBrush}"
                        CornerRadius="10"
                        Padding="15"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,15">
                            <Image Source="Images/Piratcat1.png" 
                                   Width="40" 
                                   Height="40"
                                   Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding MyFieldLabel}" 
                                       Style="{StaticResource HeaderText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Мое поле -->
                        <Viewbox Grid.Row="1"
                                 Stretch="Uniform" 
                                 MaxWidth="350" 
                                 MaxHeight="350" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding MyFieldCells}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="10" Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CellStyle}">
                                            <Border Background="{Binding CellColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Разделитель -->
                <Rectangle Grid.Column="1" 
                           Fill="{StaticResource AccentBrush}"
                           Width="3" 
                           RadiusX="2" 
                           RadiusY="2"
                           VerticalAlignment="Stretch"
                           Margin="0,50"/>

                <!-- Правое поле: Поле противника (показывается всегда) -->
                <Border Grid.Column="2" 
                        Background="{StaticResource WaterBrush}"
                        CornerRadius="10"
                        Padding="15"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,15">
                            <TextBlock Text="{Binding EnemyFieldLabel}" 
                                       Style="{StaticResource HeaderText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Image Source="Images/Piratcat2.png" 
                                   Width="40" 
                                   Height="40"/>
                        </StackPanel>

                        <!-- Поле противника -->
                        <Viewbox Grid.Row="1"
                                 Stretch="Uniform" 
                                 MaxWidth="350" 
                                 MaxHeight="350" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding EnemyFieldCells}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="10" Columns="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CellStyle}">
                                            <Border Background="{Binding CellColor}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                                        <i:InvokeCommandAction 
                                                            Command="{Binding DataContext.EnemyCellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Нижняя панель управления -->
        <Border Grid.Row="2" 
                Background="{StaticResource SecondaryBrush}"
                Height="100"
                CornerRadius="10,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Статус игры -->
                <Border Grid.Column="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource DarkBrush}"
                        BorderThickness="1"
                        Padding="15,8"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding GameStatus}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="250"/>
                </Border>

                <!-- Кнопки управления -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Кнопки для фазы расстановки -->
                    <Button Content="Расставить автоматически" 
                            Command="{Binding AutoArrangeCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="200"
                            Height="38"
                            FontSize="13"
                            Visibility="{Binding ShowSetupControls, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="Готов" 
                            Command="{Binding ReadyCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="100"
                            Height="38"
                            FontSize="13"
                            Margin="10,0,0,0"
                            Visibility="{Binding ShowSetupControls, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="Начать игру" 
                            Command="{Binding StartGameCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="120"
                            Height="38"
                            FontSize="13"
                            Margin="10,0,0,0"
                            Visibility="{Binding ShowSetupControls, Converter={StaticResource BoolToVis}}"/>

                    <!-- Кнопки для фазы игры -->
                    <Button Content="🏳️ Сдаться" 
                            Command="{Binding SurrenderCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="120"
                            Height="38"
                            FontSize="13"
                            Margin="10,0,0,0"
                            Visibility="{Binding ShowGameControls, Converter={StaticResource BoolToVis}}"/>

                    <!-- Общая кнопка -->
                    <Button Content="⟲ Новая игра" 
                            Command="{Binding ResetGameCommand}"
                            Style="{StaticResource ModernButton}"
                            Width="120"
                            Height="38"
                            FontSize="13"
                            Margin="10,0,0,0"/>

                </StackPanel>

                <!-- Легенда -->
                <StackPanel Grid.Column="2" 
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="15" Height="15" Background="{StaticResource ShipBrush}" 
                                BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Корабль" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="15" Height="15" Background="{StaticResource HitBrush}" 
                                BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Попадание" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="15" Height="15" Background="#A0D1E8" 
                                BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Промах" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>